{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@models/*": ["models/*.js"],
      "@controllers/*": ["controllers/*.js"],
      "@routes/*": ["routes/*.js"],
      "@config/*": ["config/*.js"],
      "@middleware/*": ["middleware/*.js"],
      "@services/*": ["services/*.js"],
      "@types/*": ["types/*.js"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
} 